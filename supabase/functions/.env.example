# Copy to .env (gitignored) for local `supabase functions serve --env-file`,
# or push directly with `supabase secrets set --env-file supabase/functions/.env`.
# Never commit real values — only this template.

# Stripe test-mode secret key.
STRIPE_SECRET_KEY=sk_test_...

# From the Stripe webhook endpoint's "Signing secret" once it's created,
# pointing at https://<project-ref>.supabase.co/functions/v1/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price id for the Coach Planner subscription. Not set until pricing
# is decided — create-checkout-session returns a 501 until this exists.
STRIPE_COACH_PLANNER_PRICE_ID=price_...

# Optional. Defaults to https://www.padelpals.app if unset.
SITE_URL=https://www.padelpals.app
